APP_PORT=3001
ANTHROPIC_API_KEY=sk-ant-...
EXPLAIN_MODEL=claude-sonnet-4-6
ASK_MODEL=claude-sonnet-4-6
# Set true to allow scripts/refresh-snapshots.ts to use Claude web search.
ENABLE_WEB_SEARCH=false

# Optional: enables the live X narrative summary on /ai.
# Create a key at https://console.x.ai/
XAI_API_KEY= insert_key
XAI_SUMMARY_MODEL=grok-4.3

# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Without this the dashboard falls back to a hardcoded 22-May-2026 snapshot.
FRED_API_KEY=
