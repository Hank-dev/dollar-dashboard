APP_PORT=3001
ANTHROPIC_API_KEY=sk-ant-...
EXPLAIN_MODEL=claude-sonnet-4-6
ASK_MODEL=claude-sonnet-4-6
# Optional: BRIEFING_MODEL (home briefing and /dollar verdict; defaults to
# EXPLAIN_MODEL) and INTERPRETATION_MODEL (BTC panel; defaults to claude-haiku-4-5).

# Spend limits for the ask/explain routes, which need no login. Per client IP
# per hour, and across all clients per day. Defaults: 20 and 200.
LLM_PER_CLIENT_HOURLY_LIMIT=20
LLM_DAILY_LIMIT=200
# Set true to allow scripts/refresh-snapshots.ts to use Claude web search.
ENABLE_WEB_SEARCH=false

# Optional: enables the live X narrative summary on /ai.
# Create a key at https://console.x.ai/
XAI_API_KEY= insert_key
XAI_SUMMARY_MODEL=grok-4.3

# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, FRED-sourced cards show the built-in September 2026 values,
# each labelled "fallback snapshot" with its date.
FRED_API_KEY=

# SEC EDGAR asks automated clients for a contact (name or address) in the
# User-Agent. Set it here rather than in the source.
SEC_CONTACT=
